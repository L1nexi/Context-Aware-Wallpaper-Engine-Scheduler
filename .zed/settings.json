{
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": [
        {
          "external": {
            "command": "ruff",
            "arguments": [
              "format",
              "--stdin-filename",
              "{buffer_path}",
              "--quiet",
              "-",
            ],
          },
        },
        {
          "code_action": "source.fixAll",
        },
        {
          "code_action": "source.organizeImports",
        },
      ],
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__",
    "**/.pytest_tmp",
    "**/.ruff_cache",
    "**/build",
    "**/venv313",
    "**/.venv",
    "**/.claude",
    "**/.playwright-cli",
    "**/logs",
    "**/data",
    "**/.pytest_cache",
  ],
}
